{
    "layer": "top",
    "height": 26,
    "margin": 5,
    "modules-left": [
        "hyprland/workspaces",
        "custom/privacy-dots",
        "custom/lyrics"
    ],
    "modules-center": [
        // "hyprland/window"
        "image#album-art",
        "mpris"
    ],
    "modules-right": [
        "custom/mail",
        "custom/updates",
        "temperature",
        "cpu",
        "memory",
        "network",
        "custom/tailscale",
        "pulseaudio",
        "custom/noisetorch",
        "backlight",
        "battery",
        "battery#bat2",
        "tray",
        "clock"
    ],
    "custom/tailscale" : {
        "exec": "~/.config/waybar/custom/tailscale/waybar-tailscale.sh --status",
        "on-click": "exec ~/.config/waybar/custom/tailscale/waybar-tailscale.sh --toggle",
        "on-click-right": "exec ~/.config/waybar/custom/tailscale/waybar-tailscale.sh --select-exit-node",
        "exec-on-event": true,
        "format": "{icon}{text}",
        "format-icons": {
            "connected": ""
        },
        "tooltip": true,
        "return-type": "json",
        "interval": 10
    },
    "custom/privacy-dots": {
        "exec": "~/.config/waybar/custom/privacy/privacy_dots.sh",
        "return-type": "json",
        "interval": 8,
        "format": "{text}",
        "tooltip": true,
        "escape": false,
        "markup": "pango"
    },
    "custom/lyrics": {
        "exec": "~/.config/waybar/custom/spotify/show-lyrics.sh",
        "interval": 3,
        "on-click": "~/.config/waybar/custom/spotify/open-lyric-genius.sh",
        "format": "♪ {}",
        "max-length": 100
    },
    "custom/noisetorch": {
        "exec": "~/.config/waybar/custom/noisetorch/check-noisetorch-connected",
        "interval": 30,
        "format": " NT",
    },
    "custom/updates": {
        "exec": "~/.config/waybar/custom/packages/check-updates-packages",
        "interval": 300,
        "exec-if": "[ -s /tmp/packages_updates ]",
        "format": " {}",
        "return-type": "json"
    },
    "custom/mail": {
        "exec": "~/.config/waybar/custom/mail/check-mail-unread",
        "interval": 60,
        "format": " {}"
    },
    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": " {status_icon} <i>{dynamic}</i>",
        "tooltip-format": "{player}: {title} - {artist}",
        "dynamic-order": ["title", "artist"],
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "mpv": "🎵"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "ignored-players": ["kdeconnect"],
        "album-len": 10,
        "artist-len": 20,
        "title-len": 35
    },
    "image#album-art": {
        "exec": "~/.config/waybar/custom/spotify/album_art.sh",
        "size": 26,
        "interval": 5
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "on-click": "activate",
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m-1\" })' > /dev/null",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"m+1\" })' > /dev/null",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "6": "",
            "7": "",
            "8": "",
            "9": "",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 70
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "locale": "nl_BE.UTF-8",
        "timezone": "Europe/Brussels",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%H:%M}  ",
        "format-alt": "{:%Y-%m-%d} ",
        "calendar": {
            "weeks-pos": "left",
            "weeks": "{:%W}",
            "mode-mon-col": 3
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "format": " {usage}%"
    },
    "memory": {
        "format": " {}%"
    },
    "temperature": {
        "thermal-zone": 2,
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
        "critical-threshold": 80,
        "format-critical": "{icon} {temperatureC}°C",
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "network": {
        "interval": 3,
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": " {ifname}",
        "tooltip-format": " {ifname} via {gwaddr}",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "Disconnected ⚠ {ifname}",
        "format-alt": " {ifname}: {ipaddr}/{cidr}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {format_source}",
        "format-bluetooth": " {icon} {volume}% {format_source}",
        "format-bluetooth-muted": "  {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    }
}
