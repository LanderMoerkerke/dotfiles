#!/usr/bin/env bash
# Force the kernel to re-detect DP connectors after a missed USB-C hotplug
# (nouveau dGPU runtime-PM sleeps through the alt-mode renegotiation).
#
# Usage:
#   hypr-kick-dp           reprobe all DP connectors (bind this, e.g. SUPER+SHIFT+M)
#   hypr-kick-dp install   generate + install the machine-specific NOPASSWD
#                          sudoers rule this script needs (run once per machine)

set -u

connectors=()
for c in /sys/class/drm/card*-DP-*/status; do
    [[ -e "$c" ]] && connectors+=("$c")
done

if [[ ${#connectors[@]} -eq 0 ]]; then
    echo "no DP connectors found under /sys/class/drm" >&2
    exit 1
fi

if [[ "${1:-}" == "install" ]]; then
    rule="$USER ALL=(root) NOPASSWD:"
    sep=" "
    for c in "${connectors[@]}"; do
        rule+="${sep}/usr/bin/tee $c"
        sep=", "
    done

    tmp="$(mktemp)"
    trap 'rm -f "$tmp"' EXIT
    {
        echo "# Allow forcing DP connector re-detection without password (hypr-kick-dp)."
        echo "# Generated by 'hypr-kick-dp install' on $(hostname), $(date +%F)."
        echo "$rule"
    } >"$tmp"

    visudo -cf "$tmp" || { echo "generated rule failed visudo check, not installing" >&2; exit 1; }
    sudo install -m 440 "$tmp" /etc/sudoers.d/hypr-kick-dp || exit 1

    echo "installed /etc/sudoers.d/hypr-kick-dp:"
    cat "$tmp"
    exit 0
fi

ok=1
for c in "${connectors[@]}"; do
    echo detect | sudo -n tee "$c" >/dev/null || ok=0
done

if [[ $ok -eq 1 ]]; then
    notify-send 'DP reprobe' 're-detected: '"${connectors[*]}"
else
    notify-send -u critical 'DP reprobe failed' "run 'hypr-kick-dp install' (sudoers rule missing or stale)"
fi
